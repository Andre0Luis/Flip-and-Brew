# Copie para .env (não vai para o git). No EAS, cadastre cada uma como variável de ambiente do build.
# O Expo embute os valores EXPO_PUBLIC_* no app na hora do build, então rebuilde depois de mudar
# (e use `npx expo start --clear` para limpar o cache do Metro).
# Passo a passo: docs/FIREBASE.md

# --- Conta, login com Google e backup (Firebase). Sem estas chaves o app funciona offline e a Conta não aparece. ---
# Firebase Console > Configurações do projeto > Seus apps > app Web > SDK setup
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ID do cliente OAuth do tipo "Web" (Google Cloud Console > Credenciais, ou Firebase > Authentication > Google).
# Sem ele o botão "Continuar com o Google" não aparece.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Compra de moedas (RevenueCat). Sem estas chaves a compra fica desligada. ---
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Só para testar a compra no Expo Go: chave da Test Store (RevenueCat > Test Store > API keys, começa com test_).
# Não vale em build de loja.
# EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# --- Administrador: e-mails (separados por vírgula) que veem as ferramentas de teste em Ajustes. O e-mail precisa estar verificado.
# Vai dentro do app (EXPO_PUBLIC_*), então o e-mail fica visível a quem abrir o pacote.
# EXPO_PUBLIC_ADMIN_EMAILS=voce@exemplo.com

# --- Usuário de teste (npm run seed:test-user). Use um projeto Firebase de DESENVOLVIMENTO. ---
TEST_USER_EMAIL=teste@flipandbrew.app
TEST_USER_PASSWORD=

# --- Só desenvolvimento: troca o Firebase por um servidor falso na memória, para testar as telas de conta sem chaves.
# Ignorado em build de produção.
# EXPO_PUBLIC_AUTH_MODE=mock
