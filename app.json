{
  "expo": {
    "name": "Flip & Brew",
    "slug": "FlipAndBrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flipandbrew",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.andre0luis.FlipAndBrew",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1A12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andre0luis.FlipAndBrew",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6EEE1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1B120D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B8782E"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "FlipQuote",
              "displayName": "Frase do dia",
              "description": "Só a frase do dia, para começar o dia com calma.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "FlipBrew",
              "displayName": "Copo em andamento",
              "description": "O progresso do copo que está enchendo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "FlipStreak",
              "displayName": "Sequência e moedas",
              "description": "Seus dias seguidos e suas moedas.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "FlipGoal",
              "displayName": "Meta de hoje",
              "description": "Quanto falta para a sua meta offline de hoje.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "FlipMissions",
              "displayName": "Missões do dia",
              "description": "As missões de hoje que já estão concluídas.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FlipQuote",
              "label": "Frase do dia",
              "description": "Só a frase do dia.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlipBrew",
              "label": "Copo em andamento",
              "description": "O progresso do copo que está enchendo.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlipStreak",
              "label": "Sequência e moedas",
              "description": "Seus dias seguidos e suas moedas.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlipGoal",
              "label": "Meta de hoje",
              "description": "Quanto falta para a meta offline de hoje.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FlipMissions",
              "label": "Missões do dia",
              "description": "As missões de hoje.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withWorkRuntimeFix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59b9fcfb-8384-45f5-8cf9-dc7e1fd513fa"
      }
    },
    "owner": "andre0luis"
  }
}
