# Copie para .env. Nada aqui vai para o app: a API roda no servidor.

# Banco. Sem DATABASE_URL, o desenvolvimento usa um Postgres embutido (PGlite) em ./.data, sem Docker.
# Com Docker (npm run db:up): postgres://flipandbrew:flipandbrew@127.0.0.1:54329/flipandbrew
# Em produção: a URL do pooler (modo transação) do Supabase.
# DATABASE_URL=

# Login. "dev" aceita tokens assinados com DEV_JWT_SECRET (npm run dev:token) e NÃO funciona em produção.
# "supabase" (fase final do plano) valida o JWT do Supabase Auth.
AUTH_PROVIDER=dev
DEV_JWT_SECRET=troque-por-uma-frase-longa-so-para-desenvolvimento

# Login do Supabase Auth (produção). SUPABASE_URL é pública; SUPABASE_JWT_SECRET é segredo (só na Vercel).
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_JWT_SECRET=
# Chave service_role (Supabase > Project Settings > API). SÓ no servidor: com ela, excluir a conta também apaga o usuário no Supabase Auth.
# SUPABASE_SERVICE_ROLE_KEY=

# E-mails (separados por vírgula) que viram admin no primeiro login, só se o e-mail estiver verificado.
# Ponha o seu em apps/api/.env e nas variáveis da Vercel. Não commite o seu e-mail real neste arquivo (o repositório é público).
ADMIN_EMAILS=voce@exemplo.com

# E-mail transacional (boas-vindas) pela Brevo, pela API HTTP, como no backend do Clube Quinze.
# Sem BREVO_API_KEY, em desenvolvimento os e-mails só aparecem no log (assunto e destinatário).
# Sem domínio próprio, MAIL_FROM precisa ser um remetente verificado na conta da Brevo.
# BREVO_API_KEY=
# MAIL_FROM=
# MAIL_FROM_NAME=Flip & Brew

# E-mail que aparece nas páginas públicas /suporte e /excluir-conta (a App Store e a Play exigem um contato). É público; pode ser um e-mail só do app.
# SUPPORT_EMAIL=

# Origens permitidas no navegador (o app nativo não usa CORS). Vazio = nenhuma.
CORS_ORIGINS=

# Documentação (/docs e /openapi.json): ligada por padrão fora de produção; em produção, só com true.
# DOCS_ENABLED=true

PORT=8787
