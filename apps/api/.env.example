# Copie para .env. Nada aqui vai para o app: a API roda no servidor.

# Banco. Sem DATABASE_URL, o desenvolvimento usa um Postgres embutido (PGlite) em ./.data, sem Docker.
# Com Docker (npm run db:up): postgres://flipandbrew:flipandbrew@127.0.0.1:54329/flipandbrew
# Em produção: a URL do pooler (modo transação) do Supabase.
# DATABASE_URL=

# Login. "dev" aceita tokens assinados com DEV_JWT_SECRET (npm run dev:token) e NÃO funciona em produção.
# "supabase" (fase final do plano) valida o JWT do Supabase Auth.
AUTH_PROVIDER=dev
DEV_JWT_SECRET=troque-por-uma-frase-longa-so-para-desenvolvimento

# E-mails (separados por vírgula) que viram admin no primeiro login, só se o e-mail estiver verificado.
ADMIN_EMAILS=voce@exemplo.com

# Origens permitidas no navegador (o app nativo não usa CORS). Vazio = nenhuma.
CORS_ORIGINS=

PORT=8787
