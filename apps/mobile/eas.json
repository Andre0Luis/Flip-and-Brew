{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "store": {
      "extends": "production",
      "environment": "preview"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6818783993"
      }
    },
    "store": {
      "ios": {
        "ascAppId": "6818783993"
      }
    }
  }
}
